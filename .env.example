# Runtime
AEGIS_ENVIRONMENT=local
AEGIS_LOG_LEVEL=INFO
AEGIS_ALLOWED_ORIGINS=["http://localhost:5173"]

# PostgreSQL and Redis
AEGIS_DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis_ai
AEGIS_REDIS_URL=redis://localhost:6379/0

# MLflow
AEGIS_MLFLOW_TRACKING_URI=http://localhost:5000
AEGIS_MLFLOW_EXPERIMENT=aegis-ai-local

# RAG
AEGIS_VECTOR_STORE=qdrant
AEGIS_QDRANT_URL=http://localhost:6333
AEGIS_QDRANT_COLLECTION=aegis_docs
AEGIS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM provider abstraction
AEGIS_LLM_PROVIDER=ollama
AEGIS_LLM_BASE_URL=http://localhost:11434
AEGIS_LLM_MODEL=llama3.1
AEGIS_EXTERNAL_LLM_API_KEY=

# Agent guardrails
AEGIS_AGENT_MAX_TOOL_CALLS=8
AEGIS_AGENT_TOOL_TIMEOUT_SECONDS=15

# Expensive endpoint protection
AEGIS_EXPENSIVE_ENDPOINT_RATE_LIMIT=10/minute

# Observability
AEGIS_PROMETHEUS_ENABLED=true
